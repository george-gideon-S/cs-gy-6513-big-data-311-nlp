# raw / large data
data/
delta/
*.parquet
*.csv
!dashboard/assets/*.csv

# checkpoints
spark-warehouse/
.checkpoint/
*.crc
_SUCCESS

# trained models. heavy spark PipelineModels stay on drive only;
# the slim portable artifacts that the deployed dashboard loads are
# kept in git so streamlit cloud can serve a working demo.
models/
!models/.gitkeep
!models/portable/
!models/portable/.gitkeep
!models/portable/*.npz
!models/portable/*.kv

# dashboard runtime artifacts. the deployed app reads these directly at
# request time, so they need to be in the repo. the heavy intermediate
# parquets stay on drive (those are excluded by the *.parquet rule above).

# dev-only phase notebooks (superseded by FINAL_PROJECT_311_NLP.ipynb).
# the unified notebook is the only one that matters.
notebooks/00_*.ipynb
notebooks/01_*.ipynb
notebooks/02_*.ipynb
notebooks/03_*.ipynb
notebooks/04_*.ipynb
notebooks/05_*.ipynb
notebooks/06_*.ipynb
notebooks/07_*.ipynb
notebooks/08_*.ipynb
notebooks/09_*.ipynb
notebooks/10_*.ipynb

